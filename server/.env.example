# TrustGuard AI Backend Environment Configuration

# Server Port
PORT=5000

# Client Application URL for CORS
CLIENT_URL=http://localhost:5173

# JSON Web Token Secret
JWT_SECRET=trustguard_super_secure_jwt_secret_change_in_production_key_2026

# Supabase PostgreSQL Configuration
# Found in Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
# Service role key has admin privileges to bypass RLS on backend
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API Key
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key

# Optional: Default Gemini Model (defaults to gemini-1.5-flash or gemini-2.0-flash)
GEMINI_MODEL=gemini-1.5-flash
